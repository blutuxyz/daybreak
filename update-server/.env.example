# Copy to .env for local runs. On Coolify, set these as environment variables instead.

# The GitHub repository whose releases are served ("owner/name").
GITHUB_REPO=blutuxyz/daybreak

# Optional. The GitHub API address, for GitHub Enterprise.
# GITHUB_API_URL=https://api.github.com

# Optional. A GitHub token with read access to the repository. Needed only if the repository is
# private; it also lifts GitHub's rate limit.
# GITHUB_TOKEN=

# Optional. A long random secret. With it, CI can call POST /v1/refresh the moment a release is
# ready. Without it the server still notices new releases within CACHE_TTL_SECONDS.
# REFRESH_TOKEN=

# Optional. The public https address of this server, if links come out wrong behind your proxy.
# PUBLIC_URL=https://updates.example.com

# Where downloaded APKs are kept. On Coolify, mount a persistent volume at /data.
# DATA_DIR=/data

# How long the release list is reused before GitHub is asked again.
# CACHE_TTL_SECONDS=300

# How many APK versions to keep on disk.
# KEEP_APKS=3
