# Daybreak keeps the WebUntis mobile models intact for R8. Gson itself is used
# only through JsonObject/JsonArray, so no reflective adapters are required.
-keepattributes Signature
-keepattributes *Annotation*
-keep class com.bdersolutions.daybreak.untis.** { *; }

# Glance and WorkManager receivers/components are referenced from the manifest.
-keep class com.bdersolutions.daybreak.widget.** { *; }
